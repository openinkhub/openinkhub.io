{
  "name": "openinkhub-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for openinkhub.io — every original WordPress URL and SEO tag preserved",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs && node tools/seo-audit.mjs",
    "verify": "node tools/verify.mjs",
    "dupcheck": "node tools/dupcheck.mjs",
    "city-posts": "node tools/city-posts.mjs",
    "test": "npm run build && npm run verify && node tools/dupcheck.mjs 0.25 && node tools/check-links.mjs",
    "preview": "node tools/serve.mjs",
    "dev": "npm run build && npm run preview",
    "audit": "node tools/seo-audit.mjs",
    "import-squirrly": "node tools/import-squirrly.mjs",
    "articles": "node tools/articles.mjs",
    "brief-posts": "node tools/brief-posts.mjs",
    "check-links": "node tools/check-links.mjs",
    "indexnow": "node tools/indexnow.mjs"
  }
}
