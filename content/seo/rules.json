{
  "_note": "SEO rules for openinkhub.io. Auto-configured defaults; edit values and run `npm test`. Used by tools/seo-fix.mjs (automatic fixes at build time) and tools/seo-audit.mjs (checklist + /admin report).",
  "site": {
    "name": "openink Hub",
    "legalName": "Openink Hub",
    "url": "https://openinkhub.io",
    "logo": "https://openinkhub.io/images/brand/openink-logo.png",
    "defaultImage": "https://openinkhub.io/wp-content/uploads/2026/07/business-process-optimization-1.webp",
    "locale": "en_IN",
    "twitterCard": "summary_large_image",
    "entities": [
      "Openink Hub",
      "SEO",
      "AEO",
      "GEO",
      "AIO",
      "WhatsApp",
      "Google Business Profile",
      "Ranchi"
    ],
    "twitterHandle": "@Openinkhub"
  },
  "sections": [
    {
      "id": "pages",
      "label": "Pages",
      "match": {
        "type": [
          "home",
          "page"
        ]
      }
    },
    {
      "id": "articles",
      "label": "Website development articles",
      "match": {
        "type": [
          "post"
        ],
        "has": "brief_hub"
      }
    },
    {
      "id": "posts",
      "label": "Blog posts",
      "match": {
        "type": [
          "post"
        ],
        "notCategory": "/category/seo-agency-by-city/"
      }
    },
    {
      "id": "city",
      "label": "SEO city guides",
      "match": {
        "type": [
          "post"
        ],
        "category": "/category/seo-agency-by-city/"
      }
    },
    {
      "id": "whatsapp",
      "label": "WhatsApp guides",
      "match": {
        "type": [
          "guide"
        ],
        "has": "whatsapp_guide"
      }
    },
    {
      "id": "guides",
      "label": "Website development guides",
      "match": {
        "type": [
          "guide"
        ]
      }
    },
    {
      "id": "listings",
      "label": "Categories, tags & archives",
      "match": {
        "type": [
          "category",
          "tag",
          "archive"
        ]
      }
    }
  ],
  "keyphrase": {
    "_note": "Order of sources for each page's focus keyphrase.",
    "sources": [
      "squirrly",
      "cityPost",
      "titlePhrase"
    ],
    "cityPostPattern": "seo agency in {city}"
  },
  "thresholds": {
    "title": {
      "min": 30,
      "max": 60
    },
    "description": {
      "min": 70,
      "max": 160
    },
    "slug": {
      "maxLength": 75,
      "maxWords": 8
    },
    "wordCount": {
      "page": 300,
      "post": 600,
      "guide": 600,
      "home": 300,
      "category": 0,
      "tag": 0,
      "archive": 0
    },
    "keyphraseDensity": {
      "min": 0.3,
      "max": 2.5
    },
    "sentenceLength": {
      "longSentenceWords": 20,
      "maxPercentLong": 25,
      "splitOver": 16
    },
    "paragraphLength": {
      "maxWords": 120
    },
    "subheadingDistribution": {
      "maxWordsWithoutHeading": 300
    },
    "passiveVoice": {
      "maxPercent": 10
    },
    "transitionWords": {
      "minPercent": 20,
      "minSentenceWords": 6,
      "_note": "share of prose sentences (6+ words) that contain a transition word; shorter fragments such as labels and table cells are skipped"
    },
    "consecutiveSentences": {
      "maxRun": 2
    },
    "wordComplexity": {
      "maxPercentComplex": 20
    },
    "readability": {
      "minFleschGood": 50,
      "minFleschOk": 30
    },
    "textToImage": {
      "minWordsPerImage": 80
    },
    "internalLinks": {
      "min": 3
    },
    "outboundLinks": {
      "minForPosts": 1
    },
    "anchors": {
      "maxPercentGeneric": 15
    },
    "uniqueness": {
      "maxOverlapWarn": 0.25,
      "maxOverlapFail": 0.5
    },
    "freshness": {
      "warnAfterDays": 365,
      "failAfterDays": 730
    },
    "crawlDepth": {
      "max": 3
    },
    "pageWeight": {
      "maxHtmlKB": 150,
      "maxImagesPerPage": 30,
      "maxImagesPerPageOverrides": {
        "_note": "gallery pages whose extra images are all lazy-loaded screenshots",
        "/our-success-stories/": 160,
        "/category/website-development/": 200,
        "/category/best-seo-content-agency/": 220
      }
    },
    "faq": {
      "minQuestions": 3
    }
  },
  "autofix": {
    "_note": "Safe fixes applied automatically on every build. Set any to false to turn it off.",
    "metaDescription": true,
    "metaDescriptionLength": true,
    "titleSiteName": true,
    "listingHeadings": true,
    "plainLanguage": true,
    "copyEdits": true,
    "faqAdditions": true,
    "simpleWords": true,
    "shortSentences": true,
    "longParagraphs": true,
    "titleYear": true,
    "topicKits": true,
    "cardLayout": true,
    "plainFaq": true,
    "linkText": true,
    "openGraph": true,
    "twitterCard": true,
    "socialSync": true,
    "excerpt": true,
    "imageAlt": true,
    "imageDimensions": true,
    "breadcrumbSchema": true,
    "organizationSchema": true,
    "entitySchema": true,
    "websiteSchema": true,
    "articleSchema": true,
